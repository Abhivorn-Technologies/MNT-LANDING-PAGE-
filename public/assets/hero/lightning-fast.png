<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 90" width="340" height="90" fill="none">
  <defs>
    <linearGradient id="badgeBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1A1A22" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#0D0D12" stop-opacity="0.98"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FA4C00"/>
      <stop offset="100%" stop-color="#FFBD59"/>
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FA4C00" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#FFBD59" stop-opacity="0.3"/>
    </linearGradient>
    <filter id="badgeGlow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#000000" flood-opacity="0.75"/>
      <feDropShadow dx="0" dy="2" stdDeviation="8" flood-color="#FA4C00" flood-opacity="0.35"/>
    </filter>
  </defs>

  <g filter="url(#badgeGlow)">
    <!-- Main Card Body -->
    <rect x="6" y="6" width="328" height="76" rx="24" fill="url(#badgeBg)"/>
    <rect x="6" y="6" width="328" height="76" rx="24" stroke="url(#borderGrad)" stroke-width="1.5"/>

    <!-- Left Orange Emblem Container -->
    <rect x="16" y="16" width="56" height="56" rx="18" fill="url(#orangeGrad)"/>
    
    <!-- Lightning Bolt Icon -->
    <path d="M46 25L33 44H44L39 63L55 42H44L46 25Z" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="1.2" stroke-linejoin="round"/>

    <!-- Content Typography -->
    <text x="84" y="38" fill="#FA4C00" font-family="'Outfit', 'Inter', -apple-system, sans-serif" font-weight="800" font-size="12" letter-spacing="1.5">LIGHTNING FAST</text>
    <text x="84" y="60" fill="#FFFFFF" font-family="'Outfit', 'Inter', -apple-system, sans-serif" font-weight="700" font-size="16" letter-spacing="0.2">10-15 Min Delivery</text>

    <!-- Live Status Pulse Indicator -->
    <circle cx="312" cy="24" r="4" fill="#10B981"/>
    <circle cx="312" cy="24" r="8" stroke="#10B981" stroke-width="1.5" opacity="0.4"/>
  </g>
</svg>