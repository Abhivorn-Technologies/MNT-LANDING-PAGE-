<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 800" fill="none">
  <defs>
    <linearGradient id="heroPhoneG" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#25252E"/>
      <stop offset="100%" stop-color="#0E0E12"/>
    </linearGradient>
    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141418"/>
      <stop offset="100%" stop-color="#070709"/>
    </linearGradient>
    <linearGradient id="accentOrange" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FA4C00"/>
      <stop offset="100%" stop-color="#FFBD59"/>
    </linearGradient>
  </defs>
  <!-- Phone Outer Body -->
  <rect x="10" y="10" width="400" height="780" rx="54" fill="url(#heroPhoneG)" stroke="#3A3A48" stroke-width="5"/>
  <!-- Phone Screen -->
  <rect x="25" y="25" width="370" height="750" rx="44" fill="url(#screenGrad)"/>
  <!-- Dynamic Island Notch -->
  <rect x="145" y="38" width="130" height="28" rx="14" fill="#000000"/>
  <circle cx="255" cy="52" r="5" fill="#1C1C24"/>
  <!-- App Header -->
  <rect x="45" y="85" width="140" height="24" rx="8" fill="#1E1E26"/>
  <text x="55" y="101" fill="#FA4C00" font-family="Outfit, sans-serif" font-weight="800" font-size="12">MN TRENDS</text>
  <circle cx="360" cy="97" r="16" fill="#FA4C00" fill-opacity="0.2"/>
  <circle cx="360" cy="97" r="6" fill="#FA4C00"/>
  <!-- Search Bar -->
  <rect x="45" y="125" width="330" height="48" rx="16" fill="#1A1A22" stroke="rgba(255,255,255,0.08)"/>
  <text x="85" y="154" fill="#8E8E9A" font-family="Inter, sans-serif" font-size="13">Search 10,000+ trends & groceries...</text>
  <circle cx="65" cy="149" r="7" stroke="#FA4C00" stroke-width="2" fill="none"/>
  <!-- Banner Promo -->
  <rect x="45" y="190" width="330" height="150" rx="20" fill="url(#accentOrange)"/>
  <text x="65" y="235" fill="#FFFFFF" font-family="Outfit, sans-serif" font-weight="900" font-size="22">MEGA SALE</text>
  <text x="65" y="260" fill="#FFF8EF" font-family="Inter, sans-serif" font-weight="600" font-size="13">Up to 60% OFF on all categories</text>
  <rect x="65" y="280" width="110" height="36" rx="18" fill="#050505"/>
  <text x="120" y="303" fill="#FFFFFF" font-family="Outfit, sans-serif" font-weight="700" font-size="12" text-anchor="middle">SHOP NOW →</text>
  <!-- Category Quick Grid -->
  <rect x="45" y="360" width="72" height="72" rx="16" fill="#1D1D26"/>
  <text x="81" y="415" fill="#FFF" font-family="Inter, sans-serif" font-size="10" text-anchor="middle">Grocery</text>
  <rect x="131" y="360" width="72" height="72" rx="16" fill="#1D1D26"/>
  <text x="167" y="415" fill="#FFF" font-family="Inter, sans-serif" font-size="10" text-anchor="middle">Gadgets</text>
  <rect x="217" y="360" width="72" height="72" rx="16" fill="#1D1D26"/>
  <text x="253" y="415" fill="#FFF" font-family="Inter, sans-serif" font-size="10" text-anchor="middle">Fashion</text>
  <rect x="303" y="360" width="72" height="72" rx="16" fill="#1D1D26"/>
  <text x="339" y="415" fill="#FFF" font-family="Inter, sans-serif" font-size="10" text-anchor="middle">Kitchen</text>
  <!-- Order Tracking Floating Card -->
  <rect x="45" y="450" width="330" height="120" rx="20" fill="#171720" stroke="#FA4C00" stroke-width="1.5"/>
  <text x="65" y="480" fill="#FA4C00" font-family="Outfit, sans-serif" font-weight="700" font-size="12">LIVE ORDER TRACKING</text>
  <text x="65" y="505" fill="#FFFFFF" font-family="Outfit, sans-serif" font-weight="800" font-size="16">On the way • 8 mins away</text>
  <rect x="65" y="525" width="290" height="8" rx="4" fill="#282836"/>
  <rect x="65" y="525" width="220" height="8" rx="4" fill="url(#accentOrange)"/>
  <text x="65" y="555" fill="#9CA3AF" font-family="Inter, sans-serif" font-size="11">Raider Rahul K. is nearby with your delivery</text>
  <!-- Bottom Bar -->
  <rect x="45" y="695" width="330" height="55" rx="20" fill="#13131A" stroke="rgba(255,255,255,0.06)"/>
  <circle cx="95" cy="722" r="14" fill="#FA4C00"/>
  <circle cx="165" cy="722" r="10" fill="#4B5563"/>
  <circle cx="245" cy="722" r="10" fill="#4B5563"/>
  <circle cx="325" cy="722" r="10" fill="#4B5563"/>
</svg>